{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the REMind window may do: save files the user picks, fetch public web pages and LIT Awards, open links in the browser.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "fs:allow-write-file",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ],
      "deny": [
        {
          "url": "*://localhost:*"
        },
        {
          "url": "*://(127\\..*):*"
        },
        {
          "url": "*://(10\\..*):*"
        },
        {
          "url": "*://(192\\.168\\..*):*"
        },
        {
          "url": "*://(169\\.254\\..*):*"
        },
        {
          "url": "*://(172\\.(?:1[6-9]|2\\d|3[01])\\..*):*"
        },
        {
          "url": "*://(100\\.(?:6[4-9]|[7-9]\\d|1[01]\\d|12[0-7])\\..*):*"
        },
        {
          "url": "*://(0\\..*):*"
        },
        {
          "url": "*://\\[*\\]:*"
        }
      ]
    }
  ]
}
